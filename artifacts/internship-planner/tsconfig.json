{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src/App.tsx", "src/main.tsx", "src/pages/**/*.tsx", "src/lib/**/*.ts", "src/lib/**/*.tsx", "src/planner-components/**/*.tsx", "shared/**/*.ts", "server/**/*.ts", "data/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
